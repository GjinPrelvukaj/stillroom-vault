<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bindings driven against the engine's DLL: `cargo build` in windows/engine, then `dotnet run` here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stillroom.Native\Stillroom.Native.csproj" />
    <None Include="..\..\..\target\debug\stillroom_core.dll" Link="stillroom_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
