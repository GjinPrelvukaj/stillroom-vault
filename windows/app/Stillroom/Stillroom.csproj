<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stillroom for Windows: WinUI 3 on the engine (windows/engine) through its .NET bindings. Build the engine first
       (`cargo build` there), then `dotnet build` or `dotnet run` here. Windows 11 only, as PORT.md decides. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Stillroom</RootNamespace>
    <AssemblyName>Stillroom</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Stillroom.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, carrying its own Windows App SDK: nothing to install first. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.Main hardens the process before WinUI starts, so XAML's own Main is off. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="..\..\engine\bindings\csharp\Stillroom.Native\Stillroom.Native.csproj" />
    <None Include="..\..\engine\target\$(Configuration.ToLowerInvariant())\stillroom_core.dll" Link="stillroom_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Stillroom.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
