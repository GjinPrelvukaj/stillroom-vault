<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Stillroom.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <!-- No RequestedTheme here: the window's root follows Settings › Protection › Appearance (Theme.cs), which can
         change while the app runs. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The Mac's design kit, as far as WinUI goes: Stillroom's violet (Color.vault) for the accent, on black
                 glass in the dark appearance and warm paper in the light one. "Ink" is the Mac's Color.ink, text's own
                 colour, and at low opacity every faint fill and hairline: use these, never a fixed white or black, for
                 anything on the window (a printed page, or text over a picture, is the exception). Use them as
                 ThemeResource in XAML and through Theme.Brush in code. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#B08CFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#C0A3FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#D0BAFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#E0D1FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#9A73F0</Color>
                    <Color x:Key="SystemAccentColorDark2">#845BDB</Color>
                    <Color x:Key="SystemAccentColorDark3">#6E44C4</Color>
                    <SolidColorBrush x:Key="VaultBrush" Color="#B08CFF" />
                    <SolidColorBrush x:Key="VaultWashBrush" Color="#2EB08CFF" />
                    <SolidColorBrush x:Key="GlassBrush" Color="#D9050508" />
                    <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="QuietBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ChosenBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="DotBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="FaintBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#06FFFFFF" />
                    <SolidColorBrush x:Key="ProblemBrush" Color="#D9FF6B6B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- On paper, the website's deeper violet (#6043CA), so it keeps its contrast. -->
                    <Color x:Key="SystemAccentColor">#6043CA</Color>
                    <Color x:Key="SystemAccentColorLight1">#7558D6</Color>
                    <Color x:Key="SystemAccentColorLight2">#8A6EE0</Color>
                    <Color x:Key="SystemAccentColorLight3">#A088EA</Color>
                    <Color x:Key="SystemAccentColorDark1">#6043CA</Color>
                    <Color x:Key="SystemAccentColorDark2">#5136B3</Color>
                    <Color x:Key="SystemAccentColorDark3">#432A9C</Color>
                    <SolidColorBrush x:Key="VaultBrush" Color="#6043CA" />
                    <SolidColorBrush x:Key="VaultWashBrush" Color="#246043CA" />
                    <SolidColorBrush x:Key="GlassBrush" Color="#EBF7F6F2" />
                    <SolidColorBrush x:Key="InkBrush" Color="#17151F" />
                    <SolidColorBrush x:Key="QuietBrush" Color="#9917151F" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#0F17151F" />
                    <SolidColorBrush x:Key="ChosenBrush" Color="#1A17151F" />
                    <SolidColorBrush x:Key="DotBrush" Color="#2617151F" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#1417151F" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#1217151F" />
                    <SolidColorBrush x:Key="FaintBrush" Color="#0A17151F" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#0817151F" />
                    <SolidColorBrush x:Key="ProblemBrush" Color="#E6C42B1C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="TitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource QuietBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="QuietText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource QuietBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <!-- The Mac's .quiet buttons: words only, no box. -->
            <Style x:Key="QuietButton" TargetType="HyperlinkButton">
                <Setter Property="Foreground" Value="{ThemeResource QuietBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
