# Cloudflare Pages response headers. Everything comes from this domain and nothing runs inline, apart from Cloudflare
# Web Analytics: its script from static.cloudflareinsights.com, and the visit count it sends to cloudflareinsights.com
# (no cookies, see /privacy/). The checkout page also lets in Paddle's checkout (below).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; media-src 'none'; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), xr-spatial-tracking=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Paddle's checkout, on the checkout page only: its script from cdn.paddle.com, the checkout itself in a frame from
# buy.paddle.com (sandbox-buy for testing), the styles and pictures it brings, and Apple and Google Pay in that frame.
# PayPal opens a window of its own, which a same-origin opener policy would cut off. Paddle.js also tries to load
# ProfitWell's analytics; that stays blocked, and checkout works without it. "!" drops the /* value first, so the two
# policies aren't joined.
/checkout/
  ! Content-Security-Policy
  ! Permissions-Policy
  ! Cross-Origin-Opener-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.paddle.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdn.paddle.com; img-src 'self' data: https://*.paddle.com; font-src 'self' https://*.paddle.com; connect-src 'self' https://*.paddle.com https://cloudflareinsights.com; frame-src https://buy.paddle.com https://sandbox-buy.paddle.com; media-src 'none'; object-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(self "https://buy.paddle.com" "https://sandbox-buy.paddle.com"), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# The same site on Cloudflare's own address: keep it out of search, so only www.stillroomvault.com is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pictures and link previews keep their names when they're redrawn, so they can't be immutable: a week, served from
# the cache while a newer copy is checked for in the background.
/art/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The app itself: a release's zip never changes under its name (a new version gets a new name).
/download/*.zip
  Content-Type: application/zip
  Cache-Control: public, max-age=31536000, immutable

/tools/stillroom-open.py
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="stillroom-open.py"

/tools/LICENSE.md
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
