---
// The box every free tool sits in (src/content/pages/tools/), first on its page. The tool's own markup goes in the
// slot; the classes below are shared by all eight, so each tool only styles what is its own.
import Icon from '../ui/Icon.astro';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<!-- A small app window, as Anthropic frames its prompts: a title bar with three dots and the tool's name, then the
     tool, then a line saying where it runs. -->
<section class="tool" id="tool" aria-label={label} data-tool>
  <div class="bar" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="name">{label}</span>
  </div>
  <div class="body">
    <slot />
    <noscript><p class="t-note">This tool needs JavaScript, because it runs in your browser, on your device.</p></noscript>
  </div>
  <p class="local"><Icon name="cloud-off" size={16} /> Runs in your browser. Nothing you type or drop here leaves this page.</p>
</section>

<style>
  .tool {
    margin-bottom: var(--space-12);
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--r-panel);
    background: var(--bg-raised);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.03),
      0 30px 60px -36px rgb(22 21 26 / 0.3);
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--fg) 4%, var(--bg-raised));
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .dots i:nth-child(2) {
    background: #febc2e;
  }
  .dots i:nth-child(3) {
    background: #28c840;
  }
  .name {
    color: var(--fg-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .body {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
  }
  .local {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 12px var(--space-8);
    border-top: 1px solid var(--hairline);
    color: var(--fg-quiet);
    font-size: var(--text-sm);
  }
  @media (max-width: 560px) {
    .body {
      padding: var(--space-6) var(--space-4);
    }
    .local {
      padding-inline: var(--space-4);
    }
  }
  /* Shared pieces, used by the tools' own markup. */
  .tool :global(.t-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }
  .tool :global(.t-field) {
    display: grid;
    gap: var(--space-2);
  }
  .tool :global(.t-label) {
    color: var(--fg-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .tool :global(.t-check) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg-2);
    font-size: var(--text-sm);
  }
  /* Controls, drawn the same in every browser. Rows line up on their bottom edge, so a checkbox sits level with the
     dropdown beside it, not with that dropdown's label. */
  .tool :global(.t-row) {
    align-items: flex-end;
  }
  .tool :global(.t-check) {
    min-height: 46px;
    cursor: pointer;
  }

  /* Dropdowns: no native arrow; a drawn chevron with room around it, and a width that fits a short value. */
  .tool :global(select.field) {
    min-width: 96px;
    min-height: 46px;
    padding: 10px 44px 10px 14px;
    appearance: none;
    -webkit-appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--fg-2) 50%),
      linear-gradient(135deg, var(--fg-2) 50%, transparent 50%);
    background-position:
      calc(100% - 22px) 52%,
      calc(100% - 17px) 52%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    cursor: pointer;
  }
  .tool :global(select.field:focus) {
    background-image:
      linear-gradient(45deg, transparent 50%, var(--vault) 50%),
      linear-gradient(135deg, var(--vault) 50%, transparent 50%);
    background-position:
      calc(100% - 22px) 52%,
      calc(100% - 17px) 52%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }
  .tool :global(input.field),
  .tool :global(textarea.field) {
    padding: 12px 14px;
  }

  /* Checkboxes: a rounded box that fills violet with a white tick. */
  .tool :global(input[type='checkbox']) {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    border: 1.5px solid var(--field-border);
    border-radius: 6px;
    background: var(--field);
    cursor: pointer;
    transition:
      background-color var(--hover),
      border-color var(--hover);
  }
  .tool :global(input[type='checkbox']:hover) {
    border-color: var(--vault);
  }
  .tool :global(input[type='checkbox']:checked) {
    border-color: var(--vault);
    background: var(--vault);
  }
  .tool :global(input[type='checkbox']:checked::after) {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    rotate: 45deg;
  }
  .tool :global(input[type='checkbox']:focus-visible) {
    outline: 2px solid var(--vault);
    outline-offset: 2px;
  }

  /* Sliders: a thin track and a round handle, sized to line up with the dropdowns beside them. */
  .tool :global(input[type='range']) {
    width: 180px;
    height: 46px;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    cursor: pointer;
  }
  .tool :global(input[type='range']::-webkit-slider-runnable-track) {
    height: 4px;
    border-radius: 2px;
    background: var(--hairline);
  }
  .tool :global(input[type='range']::-moz-range-track) {
    height: 4px;
    border-radius: 2px;
    background: var(--hairline);
  }
  .tool :global(input[type='range']::-moz-range-progress) {
    height: 4px;
    border-radius: 2px;
    background: var(--vault);
  }
  .tool :global(input[type='range']::-webkit-slider-thumb) {
    width: 20px;
    height: 20px;
    margin-top: -8px;
    appearance: none;
    -webkit-appearance: none;
    border: 2px solid var(--vault);
    border-radius: 50%;
    background: var(--bg-raised);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.15);
  }
  .tool :global(input[type='range']::-moz-range-thumb) {
    width: 16px;
    height: 16px;
    border: 2px solid var(--vault);
    border-radius: 50%;
    background: var(--bg-raised);
  }
  .tool :global(input[type='range']:focus-visible) {
    outline: 2px solid var(--vault);
    outline-offset: 4px;
  }
  .tool :global(.t-out) {
    padding: var(--space-6);
    border: 1px solid var(--hairline);
    border-radius: var(--r-field);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .tool :global(.t-big) {
    font-size: var(--text-4xl);
    letter-spacing: 0.08em;
  }
  .tool :global(.t-note) {
    color: var(--fg-2);
    font-size: var(--text-sm);
  }
  .tool :global(.t-good) {
    color: var(--green);
  }
  .tool :global(.t-bad) {
    color: var(--red);
  }
  .tool :global(.t-mono) {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }
  .tool :global(select.field) {
    width: auto;
  }
  /* A place to drop a file: a dashed box that lights up while something is held over it. */
  .tool :global(.t-drop) {
    position: relative;
    display: grid;
    place-items: center;
    gap: var(--space-2);
    min-height: 140px;
    padding: var(--space-6);
    border: 1.5px dashed var(--field-border);
    border-radius: var(--r-field);
    color: var(--fg-2);
    text-align: center;
    cursor: pointer;
    transition:
      border-color var(--hover),
      background-color var(--hover);
  }
  .tool :global(.t-drop.over),
  .tool :global(.t-drop:hover) {
    border-color: var(--vault);
    background: rgb(var(--vault-rgb) / 0.05);
  }
  .tool :global(.t-drop input) {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .tool :global(.t-drop:focus-within) {
    outline: 2px solid var(--vault);
    outline-offset: 2px;
  }
  .tool :global(.t-list) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tool :global(.t-list li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r-field);
    background: var(--bg);
  }
  .tool :global(.t-list .t-mono) {
    font-size: var(--text-lg);
  }
  /* A message line with nothing to say yet takes no room. */
  .tool :global(.t-note:empty) {
    display: none;
  }
  .tool :global([hidden]) {
    display: none !important;
  }
</style>
