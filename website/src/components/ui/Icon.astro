---
// Line icons drawn on a 24-point grid in the spirit of the SF Symbols the app uses. Inline, so nothing is fetched.
import { paths, type IconName } from '../../lib/icons';



interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
  stroke?: number;
}
const { name, size = 20, label, class: className, stroke = 1.6 } = Astro.props;
const fill = name === 'apple' || name === 'windows' ? 'currentColor' : 'none';
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill}
  stroke={fill === 'none' ? 'currentColor' : 'none'}
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name]}
/>
