---
// The app's DotRing: 48 dots on a circle, lit clockwise from the top, the unlit ones a faint track, the leading
// edge drawn larger. Drawn as SVG so it scales and needs no style attributes (the CSP allows none).
interface Props {
  /** How much is lit, 0 to 1. */
  lit?: number;
  size?: number;
  count?: number;
  dot?: number;
  class?: string;
  id?: string;
  label?: string;
}
const { lit = 0, size = 84, count = 48, dot = 3.2, class: className, id, label } = Astro.props;
const on = Math.ceil(count * Math.min(1, Math.max(0, lit)));
const r = size / 2 - dot * 1.6;
const c = size / 2;
const dots = Array.from({ length: count }, (_, i) => {
  const a = (i / count) * 2 * Math.PI - Math.PI / 2;
  return {
    i,
    x: +(c + r * Math.cos(a)).toFixed(2),
    y: +(c + r * Math.sin(a)).toFixed(2),
    on: i < on,
    edge: i === on - 1,
  };
});
---

<svg
  class:list={['dot-ring', className]}
  id={id}
  viewBox={`0 0 ${size} ${size}`}
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  data-count={count}
>
  {
    dots.map((d) => (
      <circle
        class:list={['dr-dot', { on: d.on, edge: d.edge }]}
        cx={d.x}
        cy={d.y}
        r={d.edge ? (dot * 1.6) / 2 : dot / 2}
        data-r={dot / 2}
      />
    ))
  }
  <slot />
</svg>

<style>
  .dot-ring {
    overflow: visible;
  }
  .dr-dot {
    fill: rgb(255 255 255 / 0.1);
    transition:
      fill var(--change),
      r var(--change);
  }
  .dr-dot.on {
    fill: var(--vault);
  }
</style>
