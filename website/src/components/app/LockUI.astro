---
// LockView: one 320-point column. The ring lights a few random dots per typed character, so it never shows the
// password's length.
import DotRing from '../ui/DotRing.astro';
import Icon from '../ui/Icon.astro';
---

<div class="lock-ui" data-lock-demo>
  <div class="lock-col">
    <div class="lock-ring">
      <DotRing size={84} lit={0} />
      <span class="lock-glyph"><Icon name="lock" size={24} stroke={1.9} /></span>
    </div>
    <div class="lock-text">
      <div class="a-title">Stillroom is locked</div>
      <div class="sub">Everything inside is encrypted on this Mac.</div>
    </div>
    <div class="a-field focused">
      <Icon name="key" size={14} />
      <span class="typed" data-typed></span><span class="caret"></span>
      <span class="hint" data-hint>Password</span>
    </div>
    <div class="msg a-quiet"></div>
    <div class="lock-buttons">
      <span class="a-btn"><Icon name="fingerprint" size={14} />Touch ID</span>
      <span class="a-btn primary">Unlock</span>
    </div>
    <div class="lock-quiet">
      <span class="a-btn quiet">Use Recovery Key</span>
      <span class="a-btn quiet">Use Emergency Kit</span>
    </div>
  </div>
</div>

<style>
  .lock-ui {
    display: grid;
    place-items: center;
    min-height: 100%;
    padding: 56px 20px 48px;
  }
  .lock-col {
    display: grid;
    justify-items: center;
    gap: 16px;
    width: min(320px, 100%);
  }
  .lock-ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
  }
  .lock-glyph {
    position: absolute;
    color: rgb(255 255 255 / 0.75);
  }
  .lock-text {
    display: grid;
    gap: 6px;
    padding-bottom: 8px;
    text-align: center;
  }
  .sub {
    color: rgb(255 255 255 / 0.55);
  }
  .a-field {
    position: relative;
    width: 100%;
  }
  .typed {
    letter-spacing: 2px;
    color: var(--fg);
  }
  .hint {
    color: rgb(255 255 255 / 0.5);
  }
  .typed:not(:empty) ~ .hint {
    display: none;
  }
  .caret {
    width: 1.5px;
    height: 16px;
    margin-left: -6px;
    background: var(--vault);
  }
  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.06s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .msg {
    min-height: 16px;
  }
  .lock-buttons {
    display: flex;
    gap: 8px;
  }
  .lock-quiet {
    display: flex;
    gap: 16px;
  }
</style>
