---
// A Login secret in the editor (Editors.swift), with a live two-factor code row (OneTimeCode, RFC 6238) under its
// setup field. The code is real TOTP from a published demo key, worked out in your browser.
import Icon from '../ui/Icon.astro';
---

<div class="secret-ui" data-totp="JBSWY3DPEHPK3PXP">
  <div class="ed-bar">
    <span class="a-btn quiet"><Icon name="arrow-left" size={14} />Secrets</span>
    <span class="a-quiet">Saved just now</span>
  </div>
  <div class="ed-head">
    <span class="tile"><Icon name="key" size={20} stroke={1.8} /></span>
    <div>
      <div class="a-eyebrow">Login</div>
      <div class="a-title">Example account</div>
    </div>
  </div>
  <div class="a-panel fields">
    <div class="f-row">
      <span class="lbl">Website</span><span class="val">example.com</span>
      <span class="tools"><Icon name="copy" size={15} /><Icon name="ellipsis" size={15} /></span>
    </div>
    <div class="f-row">
      <span class="lbl">Username</span><span class="val">you@example.com</span>
      <span class="tools"><Icon name="copy" size={15} /><Icon name="ellipsis" size={15} /></span>
    </div>
    <div class="f-row">
      <span class="lbl">Password</span><span class="val mono">••••••••••</span>
      <span class="tools"><Icon name="eye" size={15} /><Icon name="dice" size={15} /><Icon name="copy" size={15} /><Icon name="ellipsis" size={15} /></span>
    </div>
    <div class="f-row">
      <span class="lbl">Two-factor setup</span><span class="val mono">••••••••••</span>
      <span class="tools"><Icon name="eye" size={15} /><Icon name="copy" size={15} /><Icon name="ellipsis" size={15} /></span>
    </div>
    <div class="otp">
      <span class="lbl">Code</span>
      <span class="code mono" data-code>— — —&nbsp;— — —</span>
      <svg class="countdown" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <circle cx="10" cy="10" r="8" class="track"></circle>
        <circle cx="10" cy="10" r="8" class="arc" data-arc pathLength="30" stroke-dasharray="30 30"></circle>
        <text x="10" y="13" text-anchor="middle" data-left>30</text>
      </svg>
      <span class="tools"><Icon name="copy" size={15} /></span>
    </div>
  </div>
  <div class="ed-add">
    <span class="a-btn quiet"><Icon name="plus" size={14} />Add Field</span>
    <span class="a-btn quiet"><Icon name="key" size={14} />Add Password</span>
    <span class="a-btn quiet"><Icon name="clock" size={14} />Add Two-Factor</span>
  </div>
  <p class="a-quiet foot">Two-factor added. The code below changes every 30 seconds.</p>
</div>

<style>
  .secret-ui {
    max-width: 720px;
    margin-inline: auto;
    padding: 56px 40px 48px;
  }
  .ed-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .ed-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  .tile {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgb(var(--vault-rgb) / 0.22);
    border-radius: 13px;
    background: rgb(var(--vault-rgb) / 0.14);
    color: var(--vault);
  }
  .ed-head > div {
    display: grid;
    gap: 4px;
  }
  .f-row,
  .otp {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 14px;
  }
  .f-row + .f-row::before,
  .otp::before {
    content: '';
    position: absolute;
    top: 0;
    left: 14px;
    right: 0;
    height: 1px;
    background: rgb(255 255 255 / 0.05);
  }
  .lbl {
    flex: none;
    width: 130px;
    font-size: var(--app-quiet);
    color: rgb(255 255 255 / 0.6);
  }
  .val {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tools {
    display: flex;
    gap: 10px;
    color: rgb(255 255 255 / 0.55);
  }
  .otp {
    height: 46px;
    background: rgb(var(--vault-rgb) / 0.05);
    border-radius: 0 0 12px 12px;
  }
  .code {
    flex: 1;
    font-size: 17px;
    font-weight: 600;
    color: var(--vault);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .otp.soon .code {
    color: var(--orange);
  }
  .countdown {
    flex: none;
    transform: rotate(-90deg);
  }
  .countdown .track {
    fill: none;
    stroke: rgb(255 255 255 / 0.1);
    stroke-width: 2;
  }
  .countdown .arc {
    fill: none;
    stroke: var(--vault);
    stroke-width: 2;
    stroke-linecap: round;
    transition: stroke-dashoffset 1s linear;
  }
  .otp.soon .countdown .arc {
    stroke: var(--orange);
  }
  .countdown text {
    transform: rotate(90deg);
    transform-origin: 10px 10px;
    font: 600 8.5px var(--font);
    fill: rgb(255 255 255 / 0.6);
  }
  .ed-add {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 10px;
  }
  .foot {
    margin-top: 14px;
  }
  @container (max-width: 560px) {
    .secret-ui {
      padding: 52px 16px 48px;
    }
    .lbl {
      width: 92px;
    }
    .tools :global(svg:not(:last-child)) {
      display: none;
    }
    .ed-add .a-btn:nth-child(2) {
      display: none;
    }
  }
</style>
