---
// SettingsPane's Access tab, with the wording from the app.
const rows = [
  { t: 'Password', d: 'The way in that always works. At least 12 characters.', c: 'Change…' },
  {
    t: 'Open with Touch ID',
    d: 'Your finger opens this vault with a key that never leaves this Mac’s Secure Enclave. It opens one vault: turning it on here moves it from any other. If you rely on a decoy, turn it on there or nowhere, since a forced finger opens the vault it belongs to.',
    s: true,
  },
  {
    t: 'Lock to this Mac',
    d: 'The vault opens only on this Mac, even with the password: a copy of its folder is useless anywhere else. Your recovery key opens it if this Mac is lost or repaired.',
    s: false,
  },
  {
    t: 'Recovery key',
    d: 'Opens the vault on any Mac without the password. A new one stops the old one opening this vault, though backups made before still open with it.',
    c: 'New Key…',
  },
  {
    t: 'Emergency kit',
    d: 'Printed pieces for people you trust: any two of three (or your choice) open the vault if something happens to you. One alone opens nothing.',
    c: 'Make Kit…',
  },
  {
    t: 'Decoy password',
    d: 'A second password that opens a separate, harmless vault with its own recovery key and kit, for when someone makes you open Stillroom in front of them. It won’t stand up to someone who has one password and a copy of this Mac’s files. Setting one deletes whatever the other vault held.',
    c: 'Set…',
  },
];
---

<div class="settings-ui">
  <div class="a-eyebrow">Settings</div>
  <div class="a-title">How it’s kept</div>
  <div class="a-segments">
    <span class="on">Access</span><span>Protection</span><span>Security</span><span>Data</span>
  </div>
  <div class="a-group grp">Getting in</div>
  <div class="a-panel">
    {
      rows.map((r) => (
        <div class="s-row">
          <div class="s-text">
            <div>{r.t}</div>
            <div class="a-quiet">{r.d}</div>
          </div>
          {r.c ? <span class="a-btn">{r.c}</span> : <span class:list={['a-switch', { on: r.s }]} />}
        </div>
      ))
    }
  </div>
</div>

<style>
  .settings-ui {
    display: grid;
    gap: 6px;
    max-width: 820px;
    margin-inline: auto;
    padding: 56px 40px 48px;
  }
  .a-segments {
    justify-self: start;
    margin: 12px 0 14px;
  }
  .grp {
    padding-left: 4px;
  }
  .s-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 14px;
  }
  .s-row + .s-row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 14px;
    right: 0;
    height: 1px;
    background: rgb(255 255 255 / 0.05);
  }
  .s-text {
    display: grid;
    gap: 3px;
    flex: 1;
  }
  .s-text .a-quiet {
    max-width: 520px;
  }
  @container (max-width: 560px) {
    .settings-ui {
      padding: 52px 16px 48px;
    }
    .a-segments span {
      padding: 0 9px;
    }
  }
</style>
