---
// An art slot. When public/art/<name>.webp exists (see ART.md for each slot's brief), that image is shown; until
// then a drawn stand-in in the same palette fills the slot, so a page never shows a hole. Decorative either way.
import { hasArt } from '../lib/art';

interface Props {
  name: string;
  /** The stand-in's paper tint. */
  tint?: 'olive' | 'slate' | 'rose' | 'sand';
  /** The slot's shape, as width / height. */
  ratio?: string;
  /** Load it straight away (only for the first thing on a page). */
  eager?: boolean;
  /** Framed: the print keeps its own paper and grain, on a softly rounded plate (scripts/add-art.py --plate). */
  plate?: boolean;
  /** How wide it shows, for choosing between the full picture and its 800px phone copy (cards by default). */
  sizes?: string;
  class?: string;
}
const { name, tint = 'sand', ratio = '4 / 5', eager = false, plate = false, sizes = '(max-width: 900px) 92vw, 400px', class: className } =
  Astro.props;
const file = `/art/${name}.webp`;
const hasImage = hasArt(name);
// The 800px copy add-art.py makes beside each picture, when it exists.
const srcset = hasArt(`${name}-800`) ? `/art/${name}-800.webp 800w, ${file} 1600w` : undefined;
// The stand-in: the app's dot ring, offset by the slot's name so neighbouring slots differ.
let seed = 0;
for (const ch of name) seed = (seed * 31 + ch.charCodeAt(0)) >>> 0;
const cx = 100 + ((seed % 60) - 30);
const r = 48 + (seed % 22);
const dots = Array.from({ length: 40 }, (_, i) => {
  const a = (i / 40) * 2 * Math.PI - Math.PI / 2;
  return { x: +(cx + r * Math.cos(a)).toFixed(1), y: +(100 + r * Math.sin(a)).toFixed(1), on: i < 6 + (seed % 10) };
});
---

<span class:list={['art', `ratio-${ratio.replace(/\D+/g, '-')}`, hasImage ? 'has-image' : tint, { plate }, className]} aria-hidden="true">
  {
    hasImage ? (
      <img src={file} srcset={srcset} sizes={srcset && sizes} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
        {dots.map((d) => (
          <circle class:list={{ on: d.on }} cx={d.x} cy={d.y} r="2.3" />
        ))}
      </svg>
    )
  }
</span>

<style>
  .art {
    display: block;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--bg-raised);
  }
  .ratio-4-5 {
    aspect-ratio: 4 / 5;
  }
  .ratio-5-3 {
    aspect-ratio: 5 / 3;
  }
  .ratio-3-2 {
    aspect-ratio: 3 / 2;
  }
  .ratio-2-1 {
    aspect-ratio: 2 / 1;
  }
  .ratio-16-9 {
    aspect-ratio: 16 / 9;
  }
  .art img,
  .art svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The images are printed on the page's own paper (scripts/add-art.py matches it), so on paper they need no box. */
  .has-image {
    border-radius: 0;
    background: transparent;
  }
  :global(.ink) .has-image {
    border-radius: var(--r-card);
  }
  /* A plate: the print's own paper, rounded like the app's continuous corners where the browser can draw them. */
  .art.plate {
    border-radius: var(--r-card);
  }
  @supports (corner-shape: squircle) {
    .art.plate {
      border-radius: calc(var(--r-card) * 2);
      corner-shape: squircle;
    }
  }
  svg circle {
    fill: rgb(22 21 26 / 0.55);
  }
  svg circle.on {
    fill: var(--vault);
  }
  .olive {
    background: #cdc8aa;
  }
  .slate {
    background: #c6ccd3;
  }
  .rose {
    background: #dcc8bf;
  }
  .sand {
    background: #e3d9c4;
  }
</style>
