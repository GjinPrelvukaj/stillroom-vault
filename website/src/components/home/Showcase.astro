---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';

// Real screenshots of the app (public/screenshots/, made from a demo vault of invented files: see its README).
const tabs: { id: string; icon: IconName; label: string; caption: string; alt: string }[] = [
  {
    id: 'vault',
    icon: 'folder',
    label: 'Vault',
    caption: 'Everything in one list: files, notes and secrets, with folders, tags and versions.',
    alt: 'Stillroom’s window in light mode: the Documents list with tax returns, a W-2, medical reports, a will and a separation agreement, each with its folder, kind, size and date.',
  },
  {
    id: 'preview',
    icon: 'doc',
    label: 'Preview',
    caption: 'Read PDFs, pictures, notes and email right inside, without a copy left on the disk.',
    alt: 'A preview card over the blurred list, showing a 2025 tax return, with buttons to save a copy or edit it in place.',
  },
  {
    id: 'lock',
    icon: 'lock',
    label: 'Lock screen',
    caption: 'The ring lights a few random dots per key, so it never shows how long your password is.',
    alt: 'The lock screen: “Stillroom is locked”, a password being typed and the dotted ring around the lock lit in violet.',
  },
  {
    id: 'twofactor',
    icon: 'clock',
    label: 'Two-factor',
    caption: 'Two-factor codes, live beside the login, with the password kept hidden until you ask.',
    alt: 'A Google login: website, username, a hidden password and a two-factor code with its countdown.',
  },
  {
    id: 'settings',
    icon: 'gear',
    label: 'Settings',
    caption: 'Every way in on one page, in plain words, the same in both vaults.',
    alt: 'Settings, Access tab: password, Touch ID, Lock to this Mac, recovery key, emergency kit and decoy password, each explained.',
  },
];
---

<section class="section showcase" aria-labelledby="showcase-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow lit">Inside the app</p>
      <h2 id="showcase-title" class="section-title rise">One window for everything you keep private.</h2>
      <p class="lead">A native Mac app in a single colour: your files, notes and secrets in one quiet list, and nothing moves until you ask it to.</p>
    </div>

    <div class="tabs-wrap reveal">
      {/* Expanding tabs (after Skiper UI's 96 Expandable tabs): an icon each, the chosen one opens to show its name.
          Not .segments: scripts/xtabs.ts runs these, and slides the screens in the direction you move. */}
      <div class="xtabs" role="tablist" aria-label="App screens" data-xtabs>
        {
          tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <Icon name={t.icon} size={18} />
              <span class="xl"><span>{t.label}</span></span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="screens reveal" data-xtabs-stage>
      {
        tabs.map((t, i) => (
          <div class="screen" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} data-tabpanel>
            <img
              class="shot"
              src={`/screenshots/${t.id}.webp?v=4`}
              srcset={`/screenshots/${t.id}-1440.webp?v=4 1440w, /screenshots/${t.id}.webp?v=4 2880w`}
              sizes="(max-width: 1240px) 92vw, 1180px"
              width="2880"
              height="1440"
              alt={t.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <p class="caption">{t.caption}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../../scripts/xtabs';
</script>

<style>
  .tabs-wrap {
    display: flex;
    margin-bottom: 32px;
  }

  .xtabs {
    display: inline-flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    background: var(--field);
  }
  .xtabs button {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--fg-quiet);
    font: 500 var(--text-base) / 1 var(--font);
    cursor: pointer;
    transition:
      background-color var(--change),
      color var(--hover),
      padding var(--change);
  }
  .xtabs button:hover {
    background: var(--glass-strong);
    color: var(--fg);
  }
  .xtabs button[aria-selected='true'] {
    padding: 0 var(--space-4) 0 14px;
    background: var(--primary-fill);
    color: var(--on-primary);
  }
  /* The name opens from nothing to its own width (a 0fr to 1fr column), and stays in the accessibility tree. */
  .xl {
    display: grid;
    grid-template-columns: 0fr;
    opacity: 0;
    transition:
      grid-template-columns var(--change),
      opacity var(--change);
  }
  .xl > span {
    min-width: 0;
    overflow: hidden;
    padding-left: var(--space-2);
    white-space: nowrap;
  }
  [aria-selected='true'] .xl {
    grid-template-columns: 1fr;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .xtabs button,
    .xl {
      transition: none;
    }
  }
  /* While one screen hands over to the next (scripts/xtabs.ts): the old one lifts out of the flow and the box's height
     follows the new one. */
  .screens {
    position: relative;
  }
  .screens:global(.moving) {
    overflow: clip;
    overflow-clip-margin: var(--space-8);
  }
  .screen:global(.leaving) {
    position: absolute;
    inset: 0 0 auto;
    pointer-events: none;
  }
  /* The window was taken at 1440×720 points, wide and short, so it fills the content width and still shows whole. */
  .shot {
    display: block;
    width: 100%;
    height: auto;
    /* The window's 22-point corners at its 1440×720 size, as fractions of width and height, so a plain shadow can
       follow them. Not a CSS filter: Safari draws filtered images at lower resolution, which blurs the text. */
    border-radius: 1.528% / 3.056%;
    box-shadow:
      0 24px 40px -8px rgb(22 21 26 / 0.18),
      0 2px 6px rgb(22 21 26 / 0.08);
  }
  .caption {
    margin-top: 16px;
    color: var(--fg-2);
  }
</style>
