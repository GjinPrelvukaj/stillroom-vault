---
// A plain page: a hero, then content.
import Base from './Base.astro';
import HeroArt, { type ArtVariant } from '../components/HeroArt.astro';
import Art from '../components/Art.astro';
import { hasArt } from '../lib/art';
import { breadcrumbJsonLd } from '../lib/schema';

interface Props {
  /** Faint artwork beside the heading, when there's no picture. */
  art?: ArtVariant;
  /** The art slot pictured beside the heading, once its image exists (ART.md). */
  picture?: string;
  title: string;
  h1: string;
  eyebrow: string;
  description: string;
  lead?: string;
  jsonLd?: Record<string, unknown>[];
  /** The faint herb repeat behind the heading (global.css, .herb-band). */
  pattern?: boolean;
  /** The heading centred over the page, with no picture beside it. */
  centered?: boolean;
}
const { art, picture, title, h1, eyebrow, description, lead, jsonLd = [], pattern = false, centered = false } = Astro.props;
const path = Astro.url.pathname;
const pic = !centered && picture && hasArt(picture) ? picture : undefined;
---

<Base title={title} description={description} jsonLd={[breadcrumbJsonLd([[title, path]]), ...jsonLd]}>
  <header class:list={['page-hero', { 'with-picture': pic, 'herb-band': pattern, centered }]}>
    <div class="container">
      <div class="hero-text">
        <p class="eyebrow lit enter enter-1">{eyebrow}</p>
        <h1 class="page-title enter enter-2">{h1}</h1>
        {lead && <p class="lead enter enter-3">{lead}</p>}
      </div>
      {pic && <Art name={pic} ratio="3 / 2" eager plate class="hero-picture enter enter-3" />}
    </div>
    {art && !pic && <HeroArt variant={art} />}
  </header>
  <div class="page-shell">
  <div class="container page-body">
    <slot />
  </div>
  </div>
  <slot name="after" />
</Base>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    padding: var(--page-top) 0 var(--space-12);
    overflow: hidden;
  }
  .page-hero .hero-text > * {
    max-width: 820px;
  }
  .centered .hero-text {
    justify-items: center;
    text-align: center;
  }
  .centered .hero-text > * {
    max-width: 760px;
  }
  .page-body {
    padding-bottom: var(--section-y);
  }
  /* The body starts at the heading's left edge, at a readable width, rather than centred in the container. */
</style>
