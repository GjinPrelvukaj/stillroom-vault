---
import DocLayout from '../layouts/DocLayout.astro';
import OpenWithoutUs from '../components/home/OpenWithoutUs.astro';
---

<DocLayout
  doc="format"
  theme="night"
  title="Open File Format: Read a Vault Without Us"
  h1="The Stillroom Vault file format"
  eyebrow="Format 4 · public"
  description="Every file in a Stillroom Vault, byte by byte: AES-256-GCM seals, Argon2id key files, the two slots, item keys and Padmé padding. Enough to read a vault without the app."
  lead="Every file in a vault, exactly enough to read one without the app. Nothing here is secret: a vault opens with its password, its recovery key or enough kit pieces, and with nothing else."
  deep
>
  <!-- The vault folder, drawn: the same layout as the block under "The pieces" in docs/FORMAT.md. -->
  <Fragment slot="before">
    <figure class="container tree" aria-labelledby="tree-cap">
      <div class="store">
        <p class="dir">Store/</p>
        <div class="slots">
          {['a/', 'b/'].map((slot) => (
            <div class="slot">
              <p class="dir">{slot}</p>
              <ul>
                {['password.key', 'recovery.key', 'kit.key', 'cover.key', 'list', 'search'].map((file) => <li>{file}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="shared">
          <p class="dir">Files/</p>
          <p>both slots’ items, one sealed file per item and per version</p>
        </div>
        <ul class="extras">
          <li><code>intruder.pub</code> both slots’ intruder public keys</li>
          <li><code>intruder/</code> the intruder log</li>
          <li><code>touchid.key</code> when Touch ID is on</li>
          <li><code>mac.key</code> when Lock to this Mac is on</li>
        </ul>
      </div>
      <figcaption id="tree-cap">
        One folder holds a whole vault: two slots built exactly alike, and one shared folder of sealed items.
      </figcaption>
    </figure>
  </Fragment>
  <Fragment slot="after">
    <OpenWithoutUs />
  </Fragment>
</DocLayout>

<script>
  import '../scripts/terms';
</script>

<style>
  .tree {
    margin-bottom: var(--space-16);
  }
  .store {
    display: grid;
    gap: var(--space-4);
    max-width: 980px;
    margin-inline: auto;
    padding: var(--space-6);
    border: 1px solid var(--hairline);
    border-radius: var(--r-panel);
    background: var(--glass);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .dir {
    color: var(--vault);
    font-weight: 600;
  }
  .slots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .slot,
  .shared {
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    background: var(--glass-strong);
  }
  .slot ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    color: var(--fg-2);
  }
  .slot li {
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: var(--glass);
  }
  .shared {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    color: var(--fg-2);
  }
  .extras {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: var(--space-2) var(--space-2) 0;
    list-style: none;
    color: var(--fg-quiet);
  }
  .extras code {
    color: var(--fg);
    margin-right: var(--space-2);
  }
  .tree figcaption {
    margin-top: var(--space-4);
    color: var(--fg-quiet);
    font-size: var(--text-sm);
    text-align: center;
  }
  @media (max-width: 700px) {
    .slots,
    .extras {
      grid-template-columns: 1fr;
    }
  }
  /* The glossary terms scripts/terms.ts wraps, and their tip (after Skiper UI's #101, custom tooltip). */
  :global(.prose .term) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline dotted rgb(var(--vault-rgb) / 0.7);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
    cursor: help;
    transition: color var(--hover);
  }
  :global(.prose .term:hover) {
    color: var(--vault);
  }
  :global(.term-tip) {
    position: fixed;
    z-index: 70;
    width: max-content;
    max-width: min(320px, calc(100vw - 16px));
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    background: var(--bg);
    box-shadow: 0 10px 30px -12px rgb(22 21 26 / 0.25);
    color: var(--fg-2);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-wrap: pretty;
    pointer-events: none;
  }
  :global(.term-tip[hidden]) {
    display: none;
  }
  /* The arrow: a square turned 45°, its two outer edges drawn in the tip's border. */
  :global(.term-tip-arrow) {
    position: absolute;
    left: var(--arrow-x, 50%);
    width: 10px;
    height: 10px;
    border: 1px solid var(--hairline);
    background: var(--bg);
    translate: -50% 0;
    rotate: 45deg;
  }
  :global(.term-tip[data-side='top'] .term-tip-arrow) {
    bottom: -6px;
    border-top: 0;
    border-left: 0;
  }
  :global(.term-tip[data-side='bottom'] .term-tip-arrow) {
    top: -6px;
    border-right: 0;
    border-bottom: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.term-tip.in) {
      animation: tip-in var(--change) both;
    }
    :global(.term-tip.in[data-side='bottom']) {
      animation-name: tip-in-below;
    }
  }
  @keyframes tip-in {
    from {
      opacity: 0;
      transform: translateY(4px) scale(0.96);
    }
  }
  @keyframes tip-in-below {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.96);
    }
  }
</style>
