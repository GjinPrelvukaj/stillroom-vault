---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Showcase from '../components/home/Showcase.astro';
import Bento from '../components/home/Bento.astro';
import SealDemo from '../components/home/SealDemo.astro';
import NeverOnline from '../components/home/NeverOnline.astro';
import PricingCards from '../components/PricingCards.astro';
import Faq from '../components/Faq.astro';
import DownloadCta from '../components/DownloadCta.astro';
import Art from '../components/Art.astro';
import Icon from '../components/ui/Icon.astro';
import { faqJsonLd, homeFaq } from '../lib/faq';
import { softwareJsonLd } from '../lib/schema';
import { sections } from '../lib/sections';

// "Learn more": the article sections, each with its art slot (see ART.md).
const learn = [
  { s: 'guides', title: 'Keeping files private on a Mac', tint: 'olive' },
  { s: 'compare', title: 'How Stillroom compares', tint: 'slate' },
  { s: 'learn', title: 'The ideas behind a vault', tint: 'rose' },
  { s: 'for', title: 'For files that would hurt', tint: 'sand' },
] as const;
---

<Base
  title="Stillroom Vault: Offline Encrypted Vault for Mac"
  exactTitle
  description="Stillroom Vault keeps files, notes, passwords and two-factor codes sealed with AES-256-GCM on your Mac. No server, no account, no sync. Free for 25 items, $39 once."
  jsonLd={[softwareJsonLd(), faqJsonLd(homeFaq)]}
>
  <HomeHero />

  <section class="section cards-section" aria-label="Start here">
    <div class="container cards">
      <article class="card reveal card-in">
        <p class="meta"><span class="tag">Demo</span><span>In your browser</span></p>
        <h2 class="card-heading">Seal a sentence yourself</h2>
        <p class="card-text">The app’s encryption, run in your browser. Nothing you type leaves the page.</p>
        <dl class="rows">
          <div><dt>Cipher</dt><dd>AES-256-GCM</dd></div>
          <div><dt>A fresh key</dt><dd>Every seal</dd></div>
        </dl>
        <a class="bar" href="#seal-it">Try it <Icon name="arrow" size={16} /></a>
      </article>
      <article class="card reveal card-in">
        <p class="meta"><span class="tag">Security</span><span>Threat model</span></p>
        <h2 class="card-heading">What it protects against, and what it doesn’t</h2>
        <p class="card-text">Both lists, word for word from our security rules.</p>
        <dl class="rows">
          <div><dt>Independent audit</dt><dd>Not yet</dd></div>
          <div><dt>The rules</dt><dd>Eleven</dd></div>
        </dl>
        <a class="bar" href="/security/">Read the lists <Icon name="arrow" size={16} /></a>
      </article>
      <article class="card reveal card-in">
        <p class="meta"><span class="tag">Format</span><span>Public</span></p>
        <h2 class="card-heading">Open your vault without us</h2>
        <p class="card-text">Every byte is documented, and a short script opens your vault without the app.</p>
        <dl class="rows">
          <div><dt>The reader</dt><dd>stillroom-open.py</dd></div>
          <div><dt>Licence</dt><dd>MIT</dd></div>
        </dl>
        <a class="bar" href="/format/">Read the format <Icon name="arrow" size={16} /></a>
      </article>
    </div>
  </section>

  <Showcase />
  <Bento />
  <SealDemo />

  <NeverOnline />

  <section class="section" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-title" class="section-title rise">Pay once, and get the same protection in every tier.</h2>
        <p class="lead">Tiers differ in how much you keep and for how many people, and never in how safe it is.</p>
      </div>
      <PricingCards pictures={false} />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container faq">
      <div class="section-head reveal">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title" class="section-title rise">Before you trust us with your files.</h2>
      </div>
      <Faq items={homeFaq} />
      <p class="more-q quiet reveal">More on the <a href="/support/">support page</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="learn-title">
    <div class="container">
      <h2 id="learn-title" class="rule-label">Learn more</h2>
      {/* Hover or focus a print and it widens while the others narrow (after Skiper UI's 52 ExpandOnHover). */}
      <div class="learn-grid">
        {
          learn.map((l) => (
            <a class="learn-card reveal" href={`/${l.s}/`}>
              <Art name={`learn-${l.s}`} tint={l.tint} plate />
              <span class="tag">{sections[l.s].name}</span>
              <strong>{l.title}</strong>
              <span class="learn-text">{sections[l.s].lead}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <DownloadCta />
</Base>

<style>
  /* Cards: a tag, a title, a line, hairline facts, and a bar that leads on. */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--card-pad);
    border-radius: var(--r-panel);
    background: var(--bg-raised);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--fg-quiet);
    font-size: var(--text-sm);
  }
  .tag {
    justify-self: start;
    width: fit-content;
    padding: 2px var(--space-3);
    border-radius: var(--r-pill);
    background: var(--glass-strong);
    color: var(--fg-2);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .card-heading {
    margin-top: var(--space-1);
    font-size: var(--text-2xl);
    line-height: 1.2;
  }
  .card-text {
    color: var(--fg-2);
  }
  .rows {
    margin: auto 0 0;
    padding-top: var(--space-3);
  }
  .rows div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--hairline);
    font-size: var(--text-sm);
  }
  .rows dd {
    margin: 0;
    color: var(--fg-quiet);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--r-field);
    background: var(--glass-strong);
    color: var(--fg);
    text-decoration: none;
    transition: background-color var(--hover);
  }
  .bar:hover {
    background: color-mix(in srgb, var(--glass-strong), var(--fg) 6%);
  }
  /* Start-here cards arrive with the scroll (after Skiper UI's 104 Scroll reveal grid cards): the words rise into
     place, one card after another. They have no pictures: the home picture right above them stands alone. Pure CSS where the browser has
     scroll-driven animations (this replaces the usual .reveal there); elsewhere .reveal's own fallback runs. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .card-in {
        view-timeline: --card block;
        animation: card-fade linear both;
        animation-timeline: --card;
        animation-range: entry 0% entry 70%;
      }
      .card-in > :is(.meta, .card-heading, .card-text, .rows, .bar) {
        animation: card-words linear both;
        animation-timeline: --card;
        animation-range: entry 10% entry 95%;
      }
    }
    @media (min-width: 961px) {
      @supports (animation-timeline: view()) {
        .card-in:nth-child(2),
        .card-in:nth-child(2) > * {
          animation-range-start: entry 15%;
        }
        .card-in:nth-child(3),
        .card-in:nth-child(3) > * {
          animation-range-start: entry 30%;
        }
      }
    }
  }
  @keyframes card-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes card-words {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }


  /* Learn more. */
  .rule-label {
    padding: var(--space-4) 0;
    border-block: 1px solid var(--hairline);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0;
  }
  .learn-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin-top: var(--space-8);
  }
  .learn-card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    text-decoration: none;
  }
  .learn-card strong {
    font-size: var(--text-lg);
    line-height: 1.3;
  }
  .learn-text {
    color: var(--fg-quiet);
    font-size: var(--text-sm);
  }
  .learn-card:hover strong {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Expand on hover (after Skiper UI's 52 ExpandOnHover), on wide screens with a pointer only. The prints keep the
     height and the text keeps the width they have at rest, so nothing below moves; a narrowed card's text fades out
     at its edge rather than rewrapping. */
  @media (min-width: 961px) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .learn-grid {
      --col: calc((100cqi - 3 * var(--grid-gap)) / 4);
      container-type: inline-size;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      transition: grid-template-columns var(--change);
    }
    .learn-grid:has(.learn-card:nth-child(1):is(:hover, :focus-visible)) {
      grid-template-columns: 1.4fr 0.867fr 0.867fr 0.867fr;
    }
    .learn-grid:has(.learn-card:nth-child(2):is(:hover, :focus-visible)) {
      grid-template-columns: 0.867fr 1.4fr 0.867fr 0.867fr;
    }
    .learn-grid:has(.learn-card:nth-child(3):is(:hover, :focus-visible)) {
      grid-template-columns: 0.867fr 0.867fr 1.4fr 0.867fr;
    }
    .learn-grid:has(.learn-card:nth-child(4):is(:hover, :focus-visible)) {
      grid-template-columns: 0.867fr 0.867fr 0.867fr 1.4fr;
    }
    .learn-card {
      min-width: 0;
      overflow: hidden;
    }
    .learn-card :global(.art) {
      aspect-ratio: auto;
      height: calc(var(--col) * 1.25);
    }
    .learn-card > :is(strong, .learn-text) {
      width: var(--col);
    }
    .learn-grid:has(.learn-card:is(:hover, :focus-visible)) .learn-card:not(:hover, :focus-visible) > :is(strong, .learn-text) {
      mask-image: linear-gradient(90deg, #000 70%, transparent);
    }
  }

  .faq > .section-head {
    max-width: var(--readable);
  }
  .more-q {
    margin-top: var(--space-6);
    font-size: var(--text-base);
  }
  .more-q a {
    color: var(--vault);
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .learn-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .learn-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
