---
import Base from '../layouts/Base.astro';
import DownloadCta from '../components/DownloadCta.astro';
import Art from '../components/Art.astro';
import { readmeFeatures } from '../lib/readme';
import { breadcrumbJsonLd, softwareJsonLd } from '../lib/schema';
import { getCollection } from 'astro:content';

const groups = readmeFeatures();
const lead: Record<string, string> = {
  'keep-anything': 'Files of every kind, notes and secrets, in one vault with folders, tags, versions and search.',
  'view-without-unsealing-to-disk': 'Look at what’s inside without a decrypted copy landing on your SSD.',
  'ways-in': 'Four ways to open your vault, each sealing its key, plus an optional lock to this Mac. Lose one way in, use another.',
  'stay-shut': 'It locks itself, hides from capture, and keeps a log of who tried.',
  'never-locked-in': 'Your files are yours: back them up, take them out, or read the vault without us.',
};
// Four points per tab, each a name and a line of detail, so the tabs stand alike. README.md keeps the full lists.
const points: Record<string, [string, string][]> = {
  'keep-anything': [
    ['Files, notes and secrets', 'Any kind of file, plus notes, and secrets with fields for logins, cards and codes.'],
    ['Folders, tags and versions', 'Sort things your way, and go back to any earlier version of an item.'],
    ['Search inside', 'Find names and words inside documents, from a word index that is itself sealed.'],
    ['Safe moves', 'Drag files in. Each copy is read back and checked by SHA-256 before the original is deleted.'],
  ],
  'view-without-unsealing-to-disk': [
    ['Built-in viewers', 'PDFs, images, sketches, text and email open inside the app, with Quick Look for the rest.'],
    ['Streamed playback', 'Audio and video play straight from the sealed file, a chunk at a time.'],
    ['Edit in Place', 'Documents open in their own app from a RAM disk, and changes are sealed back.'],
    ['Two-factor codes', 'Live codes show under any secret holding an otpauth link or setup key.'],
  ],
  'ways-in': [
    ['Password', 'Stretched with Argon2id: 512 MB of memory and 3 passes for every guess.'],
    ['Recovery key', 'Made with the vault, to print or keep somewhere safe.'],
    ['Emergency kit', 'Shamir pieces you hand out, so any agreed number of them opens the vault.'],
    ['Touch ID and this Mac', 'Both through the Secure Enclave. Lock to this Mac makes the password alone work only here.'],
  ],
  'stay-shut': [
    ['Locks itself', 'After a while, on sleep, or with <kbd>⌃</kbd><kbd>⌥</kbd><kbd>⌘</kbd><kbd>L</kbd> from any app or the menu bar.'],
    ['Hidden from capture', 'Screenshots and screen sharing see nothing, and keyboard input is secure while it’s in front.'],
    ['Intruder log', 'Wrong tries, and optionally a photo, sealed so only an open vault reads them.'],
    ['Decoy vault', 'A second password opens a harmless vault. It stops thieves and abusers, not someone with a password and a copy of the folder (<a href="/security/#rules">rule 2</a>).'],
  ],
  'never-locked-in': [
    ['Plain export', 'Take everything out as ordinary files, whenever you like.'],
    ['Encrypted backups', 'One file you keep anywhere, restored beside the vault and swapped in with one atomic rename.'],
    ['Public format', 'Every byte on disk is written down, so anyone can check how it works.'],
    ['Open without us', 'A short Python script reads a vault on its own, without the app.'],
  ],
};
// The three things the page is about, before the detail.
const promises = [
  ['Everything in one place', 'Files of every kind, notes, secrets and two-factor codes, with folders, tags, versions and search.'],
  ['Nothing left on the disk', 'Pictures, PDFs, email and video open inside the app, so no decrypted copy lands on your SSD.'],
  ['Never locked in', 'Back up, export everything as plain files, or open the vault with a public script, without us.'],
];
// Each feature's own page (src/content/pages/features/), as the grid at the foot.
const deep = (await getCollection('pages', (p) => p.id.startsWith('features/'))).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Features: Files, Notes, Passwords and 2FA"
  description="Every Stillroom Vault feature: files, notes, passwords and 2FA codes, viewers that never write to disk, five ways in, a decoy, backups and a public format."
  jsonLd={[softwareJsonLd(), breadcrumbJsonLd([['Features', '/features/']])]}
>
  <header class="hero container">
    <p class="eyebrow lit enter enter-1">Features</p>
    <h1 class="page-title enter enter-2">Everything Stillroom Vault does, and how.</h1>
    <p class="lead enter enter-3">
      One encrypted vault on your Mac for everything you’d lock in a drawer. Every feature is in every tier, Free
      included.
    </p>
    <div class="btn-row enter enter-4">
      <a class="btn primary" href="/download/">Download for Mac</a>
      <a class="btn" href="/pricing/">See pricing</a>
    </div>
  </header>

  <div class="container shot-wrap enter enter-4">
    <img
      class="shot"
      src="/screenshots/vault.webp?v=4"
      srcset="/screenshots/vault-1440.webp?v=4 1440w, /screenshots/vault.webp?v=4 2880w"
      sizes="(max-width: 1240px) 92vw, 1180px"
      width="2880"
      height="1440"
      alt="Stillroom’s window: the Documents list with tax returns, medical reports and a will, each with its folder, kind, size and date."
      loading="eager"
      decoding="async"
    />
  </div>

  <section class="section" aria-label="In short">
    <ol class="container promises reveal">
      {
        promises.map(([title, text], i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="promise-title">{title}</h2>
            <p class="quiet">{text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- The five groups from README.md as tabs: one open at a time, so the page stays short. -->
  <section class="section" aria-labelledby="groups-title">
    <div class="container">
      <div class="section-head center reveal">
        <h2 id="groups-title" class="section-title">How it works, part by part.</h2>
      </div>
      <div class="tabs reveal">
        <div class="segments" role="tablist" aria-label="Feature groups" data-groups>
          <span class="pill" aria-hidden="true"></span>
          {
            groups.map((g, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${g.slug}`}
                aria-controls={g.slug}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {g.title}
              </button>
            ))
          }
        </div>
      </div>
      {
        groups.map((g, i) => (
          <div class="panel-grid" role="tabpanel" id={g.slug} aria-labelledby={`tab-${g.slug}`} hidden={i !== 0} data-tabpanel>
            <div class="panel-text">
              <h3 class="panel-title">{g.title}</h3>
              {lead[g.slug] && <p class="lead">{lead[g.slug]}</p>}
              <ul class="items">
                {points[g.slug]
                  ? points[g.slug]!.map(([name, text]) => (
                      <li>
                        <span class="item-name">{name}</span>
                        <span set:html={text} />
                      </li>
                    ))
                  : g.items.map((item) => <li set:html={item} />)}
              </ul>
            </div>
            <Art name={`feature-${g.slug}`} ratio="3 / 2" plate sizes="(max-width: 900px) 92vw, 600px" />
          </div>
        ))
      }
    </div>
  </section>

  {
    deep.length > 0 && (
      <section class="section" aria-labelledby="deep-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 id="deep-title" class="section-title">Each feature, in depth</h2>
          </div>
          <ul class="library reveal">
            {deep.map((p) => (
              <li>
                <a href={`/${p.id}/`}>
                  <span class="lib-name">{p.data.name}</span>
                  <span class="quiet">{p.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <DownloadCta />
</Base>

<script>
  // Open the tab a link points at, like /features/#ways-in.
  const open = () => document.getElementById(`tab-${location.hash.slice(1)}`)?.click();
  open();
  window.addEventListener('hashchange', open);
</script>

<style>
  .hero {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--page-top) 0 var(--space-12);
    text-align: center;
  }
  .hero > * {
    max-width: 760px;
  }
  .shot-wrap {
    display: flex;
    justify-content: center;
  }
  .shot {
    width: 100%;
    max-width: 1180px;
    height: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg, 16px);
  }

  .promises {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-12);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .promises li {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
  }
  .num {
    color: var(--vault);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
  }
  .promise-title {
    font-size: var(--text-2xl);
  }

  .center {
    text-align: center;
  }
  .tabs {
    display: flex;
    justify-content: center;
    margin: var(--head-gap) 0 var(--space-12);
  }
  .panel-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-16);
    scroll-margin-top: var(--header-h);
  }
  /* The text stands as tall as the picture: the list takes the room left and shares it evenly between the points. */
  .panel-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  /* The picture grows with the text when the text runs taller, cropped rather than squeezed. */
  @media (min-width: 901px) {
    .panel-grid :global(.art) {
      align-self: stretch;
      aspect-ratio: auto;
    }
  }
  .item-name {
    color: var(--fg);
    font-weight: 500;
  }
  .panel-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 400;
  }
  .items {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .items li {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--fg-2);
  }
  .items :global(code) {
    color: var(--fg);
  }
  .items :global(a) {
    color: var(--vault);
  }

  .library {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    margin: var(--head-gap) 0 0;
    padding: 0;
    list-style: none;
  }
  .library a {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
  }
  .lib-name {
    color: var(--fg);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    transition: color var(--hover);
  }
  .library a:hover .lib-name {
    color: var(--vault);
  }

  @media (max-width: 1000px) {
    .library {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .promises,
    .panel-grid {
      grid-template-columns: 1fr;
    }
    .promises,
    .panel-grid {
      gap: var(--space-8);
    }
    .panel-grid :global(.art) {
      order: -1;
    }
    .tabs {
      justify-content: flex-start;
    }
  }
  @media (max-width: 560px) {
    .library {
      grid-template-columns: 1fr;
    }
  }
</style>
