---
// A hub for each article section (/compare/, /guides/, /moving-from/, /learn/, /for/): every page in it, in order.
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HubCards, { type HubVariant } from '../../components/HubCards.astro';
import ToolCards from '../../components/tools/ToolCards.astro';
import { ownArt } from '../../lib/art';
import { hubSections, sectionArt, sections, type Section } from '../../lib/sections';
import { site } from '../../config';

export function getStaticPaths() {
  return hubSections.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as Section;
const s = sections[section];
const pages = (await getCollection('pages', (p) => p.id.startsWith(`${section}/`))).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);
// Each hub lays its articles out its own way (HubCards).
const variant: HubVariant = ({ guides: 'featured', compare: 'grid', learn: 'gallery', for: 'stories', 'moving-from': 'moves', tools: 'grid' } as const)[section as Exclude<Section, 'features'>];
// The free tools are grouped by topic instead, after Claude Academy's use-case library (ToolCards).
const items = pages.map((p) => ({
  href: `/${p.id}/`,
  name: p.data.name,
  description: p.data.description,
  lead: p.data.lead,
  art: ownArt(`article-${p.id.replace('/', '-')}`, `page-${section}`),
}));
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: s.h1,
  itemListElement: pages.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/${p.id}/`, site.url).href,
    name: p.data.name,
  })),
};
---

<PageLayout art={sectionArt[section]} picture={`page-${section}`} title={s.title} h1={s.h1} eyebrow={s.eyebrow} description={s.description} lead={s.lead} jsonLd={[list]}>
  {section === 'tools' ? <ToolCards items={items} /> : <HubCards variant={variant} items={items} />}
</PageLayout>
