---
// Every article in src/content/pages: /compare/cryptomator/, /guides/…, /features/decoy-password/, and so on.
import { getCollection, getEntry, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import DownloadCta from '../../components/DownloadCta.astro';
import Decoy from '../../components/home/Decoy.astro';
import SealDemo from '../../components/home/SealDemo.astro';
import Passphrase from '../../components/tools/Passphrase.astro';
import Strength from '../../components/tools/Strength.astro';
import Totp from '../../components/tools/Totp.astro';
import QrReader from '../../components/tools/QrReader.astro';
import Checksum from '../../components/tools/Checksum.astro';
import RecoverySheet from '../../components/tools/RecoverySheet.astro';
import ShamirSplit from '../../components/tools/ShamirSplit.astro';
import Pin from '../../components/tools/Pin.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import { sections, type Section } from '../../lib/sections';
import { faqJsonLd } from '../../lib/faq';
import { ownArt } from '../../lib/art';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => {
    const [section, slug] = page.id.split('/') as [Section, string];
    return { params: { section, slug }, props: { page, section } };
  });
}

const { page, section } = Astro.props;
// A tool page's tool (src/content/pages/tools/), shown first.
const tools = { passphrase: Passphrase, strength: Strength, totp: Totp, qr: QrReader, checksum: Checksum, 'recovery-sheet': RecoverySheet, shamir: ShamirSplit, pin: Pin };
const Tool = page.data.tool ? tools[page.data.tool] : undefined;
// The first heading in the text, for the tool hero's "How it works" button.
const first = Tool ? (await render(page)).headings.find((h) => h.depth === 2)?.slug : undefined;
// The article's own print when it has one, else its section's, shown under the heading (no banner).
const own = `article-${page.id.replace('/', '-')}`;
const s = sections[section];
const hub: [string, string] = section === 'features' ? ['Features', '/features/'] : [s.name, `/${section}/`];
// Related pages, by their own names, in the order the article lists them.
const related = (
  await Promise.all(
    page.data.related.map(async (path) => {
      const id = path.replace(/^\/|\/$/g, '');
      const entry = await getEntry('pages', id);
      if (!entry) throw new Error(`${page.id}: related page ${path} doesn't exist`);
      return { path, name: entry.data.name, description: entry.data.description };
    }),
  )
);
---

<DocLayout
  page={page}
  picture={page.data.picture && !Tool ? ownArt(own, `page-${section}`) : undefined}
  points={page.data.points}
  quote={page.data.quote}
  theme={page.data.theme}
  title={page.data.title}
  h1={page.data.h1}
  eyebrow={s.eyebrow}
  description={page.data.description}
  lead={page.data.lead}
  trail={[hub]}
  jsonLd={page.data.faq.length ? [faqJsonLd(page.data.faq.map((f, i) => ({ id: `q${i}`, q: f.q, a: f.a })))] : []}
>
  {Tool && <ToolHero slot="hero" slug={page.id.split('/')[1]!} h1={page.data.h1} lead={page.data.lead} picture={ownArt(own, `page-${section}`)} first={first} />}
  {Tool && <Tool slot="tool" />}
  <Fragment slot="end">
    {
      page.data.faq.length > 0 && (
        <>
          <h2 id="questions">Questions</h2>
          {page.data.faq.map((f) => (
            <>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </>
          ))}
        </>
      )
    }
    {
      page.data.sources.length > 0 && (
        <>
          <h2 id="sources">Sources</h2>
          <p>What this page says about other products comes from their own pages, as they read on {page.data.updated}:</p>
          <ul>
            {page.data.sources.map((src) => (
              <li>
                <a href={src.url} target="_blank" rel="noopener noreferrer">{src.label}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
    {
      related.length > 0 && (
        <>
          <h2 id="related">Read next</h2>
          <ul class="related">
            {related.map((r) => (
              <li>
                <a href={r.path}>{r.name}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </Fragment>
  <Fragment slot="after">
    {page.id === 'features/decoy-password' && <Decoy />}
    {page.data.demo === 'seal' && <SealDemo />}
    <DownloadCta />
  </Fragment>
</DocLayout>
