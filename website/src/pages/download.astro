---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/ui/Icon.astro';
import DotRing from '../components/ui/DotRing.astro';
import { download, pricing } from '../config';
import { softwareJsonLd } from '../lib/schema';
---

<PageLayout picture="page-download"
  pattern
  title="Download for Mac (Apple Silicon)"
  h1="Download Stillroom Vault"
  eyebrow="Download"
  description="Download Stillroom Vault for Mac: Apple silicon, macOS 26 or later. Free for 25 items with every feature. Developer ID signed and notarized by Apple."
  lead={`Free for ${pricing.freeItems} items with every feature. Buy a licence key any time to remove the limit; nothing to reinstall.`}
  jsonLd={[softwareJsonLd()]}
>
  <div class="dl-grid">
    <section class="dl card reveal" aria-labelledby="mac-title">
      <div class="ring" aria-hidden="true">
        <DotRing size={132} dot={4.4} lit={1} />
        <img src="/app-icon-256.webp" width="84" height="84" alt="" />
      </div>
      <h2 id="mac-title" class="dl-title">Stillroom Vault for Mac</h2>
      <p class="quiet">Version {download.version} · {download.requires}</p>
      {
        download.placeholder ? (
          <>
            <a class="btn primary large" href={download.url} aria-describedby="dl-soon">
              <Icon name="apple" size={18} /> Download for Mac
            </a>
            <p id="dl-soon" class="soon">The 1.0 download isn’t up yet: this button points at where it will be.</p>
          </>
        ) : (
          <a class="btn primary large" href={download.url} download>
            <Icon name="apple" size={18} /> Download for Mac
          </a>
        )
      }
      <dl class="meta">
        <div><dt>File</dt><dd class="mono">{download.file}</dd></div>
        <div><dt>SHA-256</dt><dd class="mono">{download.sha256}</dd></div>
      </dl>
      <p class="quiet">
        To check the download is the real one, run <code>shasum -a 256 ~/Downloads/{download.file}</code> in Terminal: it
        should print the number above. Stillroom also checks its own signature each time it opens, and says so on the lock
        screen if the copy has been changed.
      </p>
    </section>

    <section class="side reveal" aria-labelledby="install-title">
      <h2 id="install-title" class="side-title">Install in a minute</h2>
      <ol class="steps">
        <li><span>1</span><div><strong>Open the zip</strong> and drag Stillroom to Applications.</div></li>
        <li><span>2</span><div><strong>Open it.</strong> It’s signed with a Developer ID and notarized by Apple, so macOS opens it without a warning.</div></li>
        <li><span>3</span><div><strong>Make your vault.</strong> Pick a password you won’t forget, then write down the recovery key it shows you, on paper.</div></li>
        <li><span>4</span><div><strong>Drop files in.</strong> They’re encrypted the moment they land.</div></li>
      </ol>

      <div class="win glass">
        <Icon name="windows" size={20} />
        <div>
          <strong>Windows</strong>
          <p class="quiet">In progress, and going well. No date promised: it ships when it’s as careful as the Mac app.</p>
        </div>
      </div>
      <div class="win glass">
        <Icon name="history" size={20} />
        <div>
          <strong>Updates</strong>
          <p class="quiet">
            Stillroom never checks for updates, because it never goes online. New versions appear here with
            <a href="/changelog/">release notes</a>, buyers get an email, and anyone can follow
            <a href="/changelog.xml">the releases feed</a>. In the app, Settings › Data › Check for Updates opens the
            notes in your browser and says whether yours is the newest.
          </p>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .dl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch; /* the install column is as tall as the download card */
  }
  .dl {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: 48px 32px 64px;
    text-align: center;
  }
  .ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
  }
  .ring img {
    position: absolute;
  }
  .dl-title {
    font-size: var(--text-2xl);
  }
  .soon {
    max-width: 340px;
    color: var(--fg-quiet);
    font-size: var(--text-sm);
  }
  .meta {
    display: grid;
    gap: 8px;
    width: 100%;
    max-width: 420px;
    margin: 8px 0 0;
    padding: 16px 16px;
    border: 1px solid var(--glass-border);
    border-radius: var(--r-card);
    background: var(--glass);
    text-align: left;
  }
  .meta div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 12px;
    font-size: var(--text-sm);
  }
  .meta dt {
    color: var(--fg-2);
  }
  .meta dd {
    margin: 0;
    color: var(--fg-2);
    overflow-wrap: anywhere;
  }
  .side {
    display: grid;
    grid-template-rows: auto auto 1fr 1fr; /* title, steps, then the two notes share what's left */
    gap: 16px;
  }
  .side-title {
    font-size: var(--text-2xl);
  }
  .steps {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: flex;
    gap: 16px;
    color: var(--fg-2);
  }
  .steps li > span {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary-fill);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .steps strong {
    color: var(--fg);
  }
  .win {
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: center; /* stretched to share the column, the note sits in the middle, icon level with its title */
    align-items: start;
    gap: 16px;
    padding: var(--space-6);
    border-radius: var(--r-panel);
  }
  .win :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--vault);
  }
  .win p {
    margin-top: 4px;
  }
  @media (max-width: 860px) {
    .side {
      grid-template-rows: none;
    }
    .dl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
