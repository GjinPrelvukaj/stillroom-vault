---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/ui/Icon.astro';
import DotRing from '../components/ui/DotRing.astro';
import { download, pricing } from '../config';
import { softwareJsonLd } from '../lib/schema';
---

<PageLayout
  centered
  pattern
  title="Download for Mac (Apple Silicon)"
  h1="Download Stillroom Vault"
  eyebrow="Download"
  description="Download Stillroom Vault for Mac: Apple silicon, macOS 26 or later. Free for 25 items with every feature. Developer ID signed and notarized by Apple."
  lead={`Free for ${pricing.freeItems} items with every feature. Buy a licence key any time to remove the limit; nothing to reinstall.`}
  jsonLd={[softwareJsonLd()]}
>
  <!-- One button first, then labelled rows: the label on the left, what it holds on the right. -->
  <div class="get reveal">
    <div class="ring" aria-hidden="true">
      <DotRing size={132} dot={4.4} lit={1} />
      <img src="/app-icon-256.webp" width="84" height="84" alt="" />
    </div>
    {
      download.placeholder ? (
        <>
          <a class="btn primary large" href={download.url} aria-describedby="dl-soon">
            <Icon name="apple" size={18} /> Download for Mac
          </a>
          <p id="dl-soon" class="soon">The 1.0 download isn’t up yet: this button points at where it will be.</p>
        </>
      ) : (
        <a class="btn primary large" href={download.url} download>
          <Icon name="apple" size={18} /> Download for Mac
        </a>
      )
    }
    <p class="quiet">Version {download.version} · {download.requires}</p>
  </div>

  <section class="row reveal" aria-labelledby="platforms-title">
    <div class="label">
      <h2 id="platforms-title" class="row-title">Platforms</h2>
      <p class="quiet">Where Stillroom runs today, and what’s coming.</p>
    </div>
    <ul class="card list">
      <li>
        <span><strong>Mac</strong> <span class="quiet">Apple silicon, macOS 26 or later</span></span>
        <a class="btn" href={download.url} download={download.placeholder ? undefined : ''}>Download</a>
      </li>
      <li>
        <span><strong>Windows</strong> <span class="quiet">In progress, and going well. No date promised: it ships when it’s as careful as the Mac app.</span></span>
        <span class="tag">In progress</span>
      </li>
      <li>
        <span><strong>Release notes</strong> <span class="quiet">What changed in each version</span></span>
        <a class="btn" href="/changelog/">Read</a>
      </li>
      <li>
        <span><strong>Releases feed</strong> <span class="quiet">Follow new versions in any feed reader</span></span>
        <a class="btn" href="/changelog.xml">Follow</a>
      </li>
    </ul>
  </section>

  <section class="row reveal" aria-labelledby="needs-title">
    <div class="label">
      <h2 id="needs-title" class="row-title">What you need</h2>
      <p class="quiet">A Mac, and nothing else.</p>
    </div>
    <ul class="card list">
      <li><span><strong>A Mac with Apple silicon</strong> <span class="quiet">M1 or later. Intel Macs aren’t supported.</span></span></li>
      <li><span><strong>macOS 26 or later</strong> <span class="quiet">Earlier versions of macOS can’t run it.</span></span></li>
      <li><span><strong>No account, no internet</strong> <span class="quiet">Nothing to sign up for. The app never goes online, so it works on a Mac that never does.</span></span></li>
      <li><span><strong>About 2.5 MB to download</strong> <span class="quiet">One zip, with nothing else to install.</span></span></li>
    </ul>
  </section>

  <section class="row reveal" aria-labelledby="check-title">
    <div class="label">
      <h2 id="check-title" class="row-title">Verify your copy</h2>
      <p class="quiet">Make sure the file you have is the one we published.</p>
    </div>
    <div class="card">
      <dl class="meta">
        <div><dt>File</dt><dd class="mono">{download.file}</dd></div>
        <div><dt>SHA-256</dt><dd class="mono">{download.sha256}</dd></div>
      </dl>
      <p class="quiet">
        To check the download is the real one, run <code>shasum -a 256 ~/Downloads/{download.file}</code> in Terminal: it
        should print the number above. No Terminal? Drop the zip on the <a href="/tools/file-checksum/">file checksum
        checker</a>, which recognises it. Stillroom also checks its own signature each time it opens, and says so on the
        lock screen if the copy has been changed.
      </p>
    </div>
  </section>

  <section class="row reveal" aria-labelledby="install-title">
    <div class="label">
      <h2 id="install-title" class="row-title">Install in a minute</h2>
      <p class="quiet">Four steps, then your files are sealed.</p>
    </div>
    <ol class="card steps">
      <li><span>1</span><div><strong>Open the zip</strong> and drag Stillroom to Applications.</div></li>
      <li><span>2</span><div><strong>Open it.</strong> It’s signed with a Developer ID and notarized by Apple, so macOS opens it without a warning.</div></li>
      <li><span>3</span><div><strong>Make your vault.</strong> Pick a password you won’t forget, then write down the recovery key it shows you, on paper.</div></li>
      <li><span>4</span><div><strong>Drop files in.</strong> They’re encrypted the moment they land.</div></li>
    </ol>
  </section>

  <section class="row reveal" aria-labelledby="updates-title">
    <div class="label">
      <h2 id="updates-title" class="row-title">Updates</h2>
      <p class="quiet">Manual, because the app never goes online.</p>
    </div>
    <div class="card">
      <p class="quiet">
        Stillroom never checks for updates, because it never goes online. New versions appear here with
        <a href="/changelog/">release notes</a>, buyers get an email, and anyone can follow
        <a href="/changelog.xml">the releases feed</a>. In the app, Settings › Data › Check for Updates opens the notes in
        your browser and says whether yours is the newest.
      </p>
    </div>
  </section>

  <section class="row reveal" aria-labelledby="move-title">
    <div class="label">
      <h2 id="move-title" class="row-title">Moving to a new Mac</h2>
      <p class="quiet">Your vault goes with you as one file.</p>
    </div>
    <ol class="card steps">
      <li><span>1</span><div><strong>Make a backup</strong> on the old Mac in Settings › Data. It’s one file, and it stays encrypted.</div></li>
      <li><span>2</span><div><strong>Copy it across</strong> any way you like: a USB drive, AirDrop, a cloud folder. It stays sealed on the way.</div></li>
      <li><span>3</span><div><strong>Restore it</strong> on the new Mac: choose Restore from a Backup when Stillroom first opens. If the vault was locked to the old Mac, open it with your recovery key. Touch ID and your licence key don’t travel, so turn on and paste them again.</div></li>
    </ol>
  </section>
</PageLayout>

<style>
  .get {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-20);
    text-align: center;
  }
  .ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
  }
  .ring img {
    position: absolute;
  }
  .soon {
    max-width: 44ch;
    color: var(--fg-quiet);
    font-size: var(--text-sm);
  }
  /* A labelled row: its title on the left, a card of what it holds on the right. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-8) var(--space-16);
    padding-block: var(--space-12);
    border-top: 1px solid var(--divider);
  }
  .label {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }
  .row-title {
    font-size: var(--text-3xl);
  }
  .card {
    margin: 0;
    padding: var(--space-6) var(--space-8);
    border: 1px solid var(--hairline);
    border-radius: var(--r-panel);
    background: var(--bg-raised);
  }
  .list {
    padding-block: var(--space-2);
    list-style: none;
  }
  .list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--divider);
  }
  .list li:last-child {
    border-bottom: 0;
  }
  .list li > span:first-child {
    display: grid;
    gap: 2px;
  }
  .list strong {
    color: var(--fg);
    font-weight: 600;
  }
  .list .btn {
    flex: none;
  }
  .tag {
    flex: none;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    background: rgb(var(--vault-rgb) / 0.1);
    color: var(--vault);
    font-size: var(--text-sm);
  }
  .meta {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
  }
  .meta div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-4);
  }
  .meta dt {
    color: var(--fg-quiet);
  }
  .meta dd {
    margin: 0;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .card a {
    color: var(--vault);
  }
  .steps {
    display: grid;
    gap: var(--space-4);
    list-style: none;
  }
  .steps li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: var(--space-4);
    color: var(--fg-2);
  }
  .steps span {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .steps strong {
    color: var(--fg);
  }
  @media (max-width: 800px) {
    .row {
      grid-template-columns: 1fr;
    }
    .card {
      padding: var(--space-4) var(--space-6);
    }
    .list li {
      flex-wrap: wrap;
    }
  }
</style>
