---
import PageLayout from '../layouts/PageLayout.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/ui/Icon.astro';
import Owners from '../components/Owners.astro';
import { email } from '../config';
import { faqJsonLd, homeFaq, supportFaq } from '../lib/faq';

// The topics, as cards at the top (after the collections grid of most help centres): each links to its questions.
const topics: { id: string; title: string; line: string; icon: 'key' | 'archive' | 'laptop' | 'card' | 'ellipsis' | 'mail'; count?: number }[] = [
  ...supportFaq.map((g) => ({
    id: g.id,
    title: g.title,
    count: g.items.length,
    ...({
      forgot: { line: 'Your recovery key, your emergency kit, and what’s left if both are gone.', icon: 'key' },
      backups: { line: 'Making a backup, opening an old one, and getting everything out as files.', icon: 'archive' },
      moving: { line: 'Taking your vault to a new Mac, with Lock to this Mac and Touch ID.', icon: 'laptop' },
      licences: { line: 'How the licence works, refunds, and a lost licence key.', icon: 'card' },
    } as const)[g.id as 'forgot' | 'backups' | 'moving' | 'licences'],
  })),
  { id: 'general', title: 'General questions', line: 'Syncing, the free version, audits, and which Macs it runs on.', icon: 'ellipsis', count: homeFaq.length - 1 },
  { id: 'contact', title: 'Contact', line: 'Write to us. A person reads every message.', icon: 'mail' },
];
const all = [...supportFaq.flatMap((g) => g.items), ...homeFaq.filter((q) => q.id !== 'forgot')];
---

<PageLayout
  centered
  title="Support: Forgot Password, Backups, FAQ"
  h1="Stillroom Vault support"
  eyebrow="Support"
  description="Forgot your Stillroom Vault password? Use the recovery key or emergency kit. Plus backups, moving to a new Mac, licences and how to reach support."
  lead="Answers to what people ask most, starting with the one that matters most. Still stuck? Write to us; a person reads every message."
  jsonLd={[faqJsonLd(all)]}
>
  <nav class="topics" aria-label="Topics">
    <ul class="stagger">
      {
        topics.map((t) => (
          <li>
            <a href={`#${t.id}`} class="topic-card">
              <Icon name={t.icon} size={22} />
              <strong>{t.title}</strong>
              <span class="line">{t.line}</span>
              {t.count && <span class="count">{t.count} questions</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="content">
      {
        supportFaq.map((g, i) => (
          <section id={g.id} class:list={['topic', { first: i === 0 }]} aria-labelledby={`${g.id}-title`}>
            <h2 id={`${g.id}-title`} class="topic-title">{g.title}</h2>
            {g.id === 'forgot' && (
              <p class="warn note">
                <strong>Nobody can open your vault without your password, recovery key or kit, not even us.</strong> There’s no
                reset email and no master key. That’s what keeps it safe from everyone else, too.
              </p>
            )}
            <Faq items={g.items} single />
          </section>
        ))
      }
      <section id="general" class="topic" aria-labelledby="general-title">
        <h2 id="general-title" class="topic-title">General questions</h2>
        <Faq items={homeFaq.filter((q) => q.id !== 'forgot')} single />
      </section>

      <section id="contact" class="topic" aria-labelledby="contact-title">
        <h2 id="contact-title" class="topic-title">Contact</h2>
        <div class="contacts stagger">
          <a class="contact glass" href={`mailto:${email.support}`}>
            <Icon name="lifebuoy" size={22} />
            <strong>Help with the app</strong>
            <span>{email.support}</span>
          </a>
          <a class="contact glass" href={`mailto:${email.security}`}>
            <Icon name="shield" size={22} />
            <strong>A security problem</strong>
            <span>{email.security}</span>
          </a>
          <a class="contact glass" href={`mailto:${email.hello}`}>
            <Icon name="mail" size={22} />
            <strong>Anything else</strong>
            <span>{email.hello}</span>
          </a>
          <a class="contact glass" href={`mailto:${email.legal}`}>
            <Icon name="scale" size={22} />
            <strong>Legal and licences</strong>
            <span>{email.legal}</span>
          </a>
        </div>
        <p class="quiet small">
          Stillroom Vault is made by <Owners text="two people" id="owners-support" />, so replies are honest rather than instant. Never send us your password,
          recovery key or kit pieces: we’ll never ask for them, and we don’t have your vault, so there’s nothing for us to open. Questions about an order
          can also go to Paddle, our reseller.
        </p>
      </section>
    </div>
</PageLayout>


<style>
  /* The topic cards: an icon, the topic, one line about it, and how many questions it holds. */
  .topics ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: 0 0 var(--space-20);
    padding: 0;
    list-style: none;
  }
  .topic-card {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--hairline);
    border-radius: var(--r-panel);
    background: var(--bg-raised);
    color: var(--fg-2);
    text-decoration: none;
    transition:
      border-color var(--hover),
      transform var(--hover);
  }
  .topic-card:hover {
    border-color: rgb(var(--vault-rgb) / 0.4);
    transform: translateY(-2px);
  }
  .topic-card :global(svg) {
    margin-bottom: var(--space-4);
    color: var(--vault);
  }
  .topic-card strong {
    color: var(--fg);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
  }
  .count {
    margin-top: var(--space-2);
    color: var(--fg-quiet);
    font-size: var(--text-sm);
  }
  /* The questions: one centred column. */
  .content {
    display: grid;
    gap: var(--space-16);
    max-width: 820px;
    margin-inline: auto;
  }
  .topic {
    display: grid;
    gap: 16px;
    scroll-margin-top: 92px;
  }
  .topic-title {
    font-size: var(--text-3xl);
  }
  .warn strong {
    color: var(--fg);
  }
  .contacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  .contact {
    display: grid;
    gap: 8px;
    padding: 24px;
    border-radius: var(--r-panel);
    text-decoration: none;
    transition: border-color var(--hover);
  }
  .contact:hover {
    border-color: rgb(var(--vault-rgb) / 0.35);
  }
  .contact :global(svg) {
    color: var(--vault);
  }
  .contact span {
    color: var(--fg-2);
    font-size: var(--text-base);
    overflow-wrap: anywhere;
  }
  .small {
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .topics ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .topics ul {
      grid-template-columns: 1fr;
    }
    .contacts {
      grid-template-columns: 1fr;
    }
  }
</style>
