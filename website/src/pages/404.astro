---
import Base from '../layouts/Base.astro';
import DotRing from '../components/ui/DotRing.astro';
---

<Base title="Not Found" description="This page doesn’t exist. Stillroom Vault keeps everything else where you left it.">
  <section class="nf container">
    <p class="eyebrow lit">404</p>
    <h1 class="page-title">This page isn’t here.</h1>
    <p class="lead">It may have moved, or the link has a typo. Everything else is where you left it.</p>
    <DotRing size={36} dot={2.6} lit={1} />
    <p class="quiet">Try one of these instead:</p>
    <div class="links btn-row">
      <a class="btn primary" href="/">Home</a>
      <a class="btn" href="/features/">Features</a>
      <a class="btn" href="/security/">Security</a>
      <a class="btn" href="/support/">Support</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding: var(--space-24) 0 var(--space-20);
  }
  .links {
    margin-top: var(--space-2);
  }
</style>
